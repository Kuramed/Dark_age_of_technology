generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int                @id @default(autoincrement())
  name             String
  email            String             @unique
  password         String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  cursosMinistrados Curso[]           @relation("InstrutorCursos")
  matriculas       Matricula[]
  progressoAulas   ProgressoAula[]
  avaliacoes       Avaliacao[]
  certificados     Certificado[]
  assinaturas      Assinatura[]
}

model Categoria {
  id          Int      @id @default(autoincrement())
  nome        String   @unique
  descricao   String?
  cursos      Curso[]
  trilhas     Trilha[]
}

model Curso {
  id             Int              @id @default(autoincrement())
  titulo         String
  descricao      String
  idInstrutor    Int
  instrutor      User             @relation("InstrutorCursos", fields: [idInstrutor], references: [id])
  idCategoria    Int
  categoria      Categoria        @relation(fields: [idCategoria], references: [id])
  nivel          String           // Iniciante, Intermediário, Avançado
  dataPublicacao DateTime         @default(now())
  totalAulas     Int              @default(0)
  totalHoras     Float            @default(0)
  modulos        Modulo[]
  matriculas     Matricula[]
  avaliacoes     Avaliacao[]
  trilhasCursos  TrilhasCursos[]
  certificados   Certificado[]
}

model Modulo {
  id       Int     @id @default(autoincrement())
  idCurso  Int
  curso    Curso   @relation(fields: [idCurso], references: [id], onDelete: Cascade)
  titulo   String
  ordem    Int
  aulas    Aula[]
}

model Aula {
  id             Int             @id @default(autoincrement())
  idModulo       Int
  modulo         Modulo          @relation(fields: [idModulo], references: [id], onDelete: Cascade)
  titulo         String
  tipoConteudo   String          // Vídeo, Texto, Quiz
  urlConteudo    String
  duracaoMinutos Int
  ordem          Int
  progresso      ProgressoAula[]
}

model Matricula {
  id            Int       @id @default(autoincrement())
  idUsuario     Int
  usuario       User      @relation(fields: [idUsuario], references: [id])
  idCurso       Int
  curso         Curso     @relation(fields: [idCurso], references: [id])
  dataMatricula DateTime  @default(now())
  dataConclusao DateTime?
}

model ProgressoAula {
  idUsuario     Int
  usuario       User     @relation(fields: [idUsuario], references: [id])
  idAula        Int
  aula          Aula     @relation(fields: [idAula], references: [id])
  dataConclusao DateTime @default(now())
  status        String   // Concluído, Em andamento

  @@id([idUsuario, idAula])
}

model Avaliacao {
  id             Int      @id @default(autoincrement())
  idUsuario      Int
  usuario        User     @relation(fields: [idUsuario], references: [id])
  idCurso        Int
  curso          Curso    @relation(fields: [idCurso], references: [id])
  nota           Int      // 1 a 5
  comentario     String?
  dataAvaliacao  DateTime @default(now())
}

model Trilha {
  id           Int             @id @default(autoincrement())
  titulo       String
  descricao    String
  idCategoria  Int
  categoria    Categoria       @relation(fields: [idCategoria], references: [id])
  trilhasCursos TrilhasCursos[]
  certificados Certificado[]
}

model TrilhasCursos {
  idTrilha Int
  trilha   Trilha @relation(fields: [idTrilha], references: [id])
  idCurso  Int
  curso    Curso  @relation(fields: [idCurso], references: [id])
  ordem    Int

  @@id([idTrilha, idCurso])
}

model Certificado {
  id                Int      @id @default(autoincrement())
  idUsuario         Int
  usuario           User     @relation(fields: [idUsuario], references: [id])
  idCurso           Int?
  curso             Curso?   @relation(fields: [idCurso], references: [id])
  idTrilha          Int?
  trilha            Trilha?  @relation(fields: [idTrilha], references: [id])
  codigoVerificacao String   @unique
  dataEmissao       DateTime @default(now())
}

model Plano {
  id           Int          @id @default(autoincrement())
  nome         String
  descricao    String?
  preco        Float
  duracaoMeses Int
  assinaturas  Assinatura[]
}

model Assinatura {
  id         Int         @id @default(autoincrement())
  idUsuario  Int
  usuario    User        @relation(fields: [idUsuario], references: [id])
  idPlano    Int
  plano      Plano       @relation(fields: [idPlano], references: [id])
  dataInicio DateTime    @default(now())
  dataFim    DateTime
  pagamentos Pagamento[]
}

model Pagamento {
  id                 Int        @id @default(autoincrement())
  idAssinatura       Int
  assinatura         Assinatura @relation(fields: [idAssinatura], references: [id])
  valorPago          Float
  dataPagamento      DateTime   @default(now())
  metodoPagamento    String     // Cartão, Pix, Boleto
  idTransacaoGateway String
}